# Copy this file to .env and fill in real values. Never commit .env.
NODE_ENV=development
PORT=5001
# Where the React client runs; used for CORS.
CLIENT_URL=http://localhost:5173
# MongoDB connection string (Atlas: mongodb+srv://...)
MONGODB_URI=
# Secret used to sign login tokens, at least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Password hashing cost (default 12).
# BCRYPT_ROUNDS=12
# Google Gemini API key, for the AI agents. Without it, AI features are turned off.
GEMINI_API_KEY=
# Optional: model overrides.
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_FALLBACK_MODEL=gemini-3.5-flash

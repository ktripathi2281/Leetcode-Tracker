{
  "name": "leetcode-tracker-v2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "client",
    "extension"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n server,client -c blue,magenta \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w server && npm run build -w client && npm run build -w extension",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "oxlint"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "oxlint": "^1.85.0",
    "typescript": "^7.0.2"
  }
}
